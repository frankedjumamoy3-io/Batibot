{
  "name": "batibot",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "scripts": {
    "start": "node ./scripts/start-expo-fixed.js",
    "start:clear": "node ./scripts/start-expo-fixed.js --clear",
    "start:fresh": "node ./scripts/clean-metro-cache.js && node ./scripts/start-expo-fixed.js --clear",
    "start:android": "node ./scripts/start-expo-fixed.js --android",
    "start:tunnel": "node ./scripts/start-expo-fixed.js --tunnel --clear",
    "start:web": "node ./scripts/start-expo-fixed.js --web --clear",
    "clean:metro": "node ./scripts/clean-metro-cache.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node ./scripts/start-expo-fixed.js --android",
    "build:android:apk": "set EAS_NO_VCS=1&& npx eas-cli build --platform android --profile preview",
    "build:android:apk:local": "set EAS_NO_VCS=1&& npx eas-cli build --platform android --profile preview --local",
    "typecheck": "tsc --noEmit",
    "validate:architecture-boundaries": "node ./scripts/validate-clean-architecture.js",
    "validate:active-learning-framework": "node ./scripts/validate-active-learning-framework.js",
    "validate:asset-resolution": "node ./scripts/validate-global-asset-resolution.js",
    "validate:preschool-play": "node ./scripts/validate-preschool-play-design.js",
    "test:frontend": "npm run typecheck && npm run lint && npm run validate:architecture-boundaries && npm run validate:asset-resolution && npm run validate:preschool-play && npm run validate:active-learning-framework && npm run export:web",
    "test:backend": "node --check ./firebase/functions/index.js && npm run validate:learning-architecture && npx firebase-tools deploy --only firestore:rules,storage --dry-run",
    "test:app": "npm run test:frontend && npm run test:backend",
    "export:vocabulary": "node ./scripts/export-vocabulary-copy-list.js",
    "cleanup:firestore": "node ./scripts/cleanup-firestore-safe.js",
    "export:learning-architecture": "node ./scripts/sync-learning-architecture-firestore.js --dry-run --export-json",
    "sync:learning-architecture:firestore": "node ./scripts/sync-learning-architecture-firestore.js",
    "validate:learning-architecture": "node ./scripts/sync-learning-architecture-firestore.js --dry-run",
    "sync:vocabulary:firestore": "node ./scripts/sync-vocabulary-firestore.js",
    "sync:vocabulary:firestore:rest": "node ./scripts/sync-vocabulary-firestore-rest.js",
    "export:web": "npx expo export --platform web",
    "deploy:web": "npm run export:web && npx firebase-tools deploy --only hosting",
    "ios": "expo start --ios --clear --host lan --port 8082",
    "web": "node ./scripts/start-expo-fixed.js --web --clear",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@iconify/react": "^6.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.2.2",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "expo": "~54.0.35",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.11.0",
    "lottie-react-native": "~7.3.1",
    "lucide-react-native": "^1.21.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "protobufjs": "7.5.5",
    "@xmldom/xmldom": "0.8.13"
  },
  "private": true
}

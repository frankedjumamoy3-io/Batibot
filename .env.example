# Copy this file to .env on a new machine, then fill in the values from your
# Firebase project settings (Project settings > General > Your apps > Web app).
# EXPO_PUBLIC_* values are bundled into the client app. Do not put private keys
# or the Gemini API key in this file.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: only needed when using a different deployed Functions endpoint or
# a different approved admin email from the project defaults.
EXPO_PUBLIC_GEMINI_QUIZ_ENDPOINT=
EXPO_PUBLIC_BATIBOT_ADMIN_EMAIL=

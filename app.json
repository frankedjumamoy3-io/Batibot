{
  "expo": {
    "name": "BatiBot",
    "slug": "batibot",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "batibot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.iansa.batibot",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow BatiBot to turn spoken words into vocabulary searches.",
        "NSMicrophoneUsageDescription": "Allow BatiBot to listen for vocabulary voice searches."
      }
    },
    "android": {
      "package": "com.iansa.batibot",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0799AD",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0799AD",
          "dark": {
            "backgroundColor": "#0799AD"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow BatiBot to listen for vocabulary voice searches.",
          "speechRecognitionPermission": "Allow BatiBot to turn spoken words into vocabulary searches.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c9086fb-4769-46d7-91fd-56b80c3337e6"
      }
    }
  }
}
